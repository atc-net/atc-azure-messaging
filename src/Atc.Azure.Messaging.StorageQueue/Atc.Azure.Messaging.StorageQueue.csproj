<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Atc.Azure.Messaging.StorageQueue</PackageId>
    <PackageTags>azure;messaging;storage;queue;publisher;processor</PackageTags>
    <Description>Typed publishers and hosted processors for Azure Storage Queues, with poison queue handling.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Queues" Version="12.28.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atc.Azure.Messaging.Abstractions\Atc.Azure.Messaging.Abstractions.csproj" />
  </ItemGroup>

</Project>
